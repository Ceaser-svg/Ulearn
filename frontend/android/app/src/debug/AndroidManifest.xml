<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- The INTERNET permission used to be declared here for development, so
         that the Flutter tool could reach the running application for hot
         reload and breakpoints. It is declared once in `main` now, which every
         build type merges, release included. Declaring it in this overlay too
         would leave two sources of truth for one permission, and the overlay is
         the copy a reader would assume does not apply to release. -->
</manifest>
